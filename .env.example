# Backend
SECRET_KEY=replace-with-random-secret
FLASK_DEBUG=False
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
ALLOW_LOCALHOST_CORS=true

# PostgreSQL (choose one approach)
DATABASE_URL=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432

# Auth email flow
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Google auth (optional; keep only if you use Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mock interview AI
OPENAI_API_KEY=
